PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
ADMIN_KEY=replace-with-a-strong-admin-key
NODE_ENV=development

# Comma-separated browser origins allowed to call this API (WHM frontend)
CORS=https://baobabnetworking.org,https://www.baobabnetworking.org

# Email notifications (Resend)
resend_api=re_example
MAIL_FROM=Webmail <milanzi@ikworx.co.za>
# Separate multiple recipients with commas
NOTIFICATION_EMAIL=info@baobabnetworking.org
